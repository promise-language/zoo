[0.197, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[1mWhat I built\r\u001b[2B\u001b[22m \u001b[3GA concur\u001b[13Gnt\u001b[16Gline-counting CLI in\u001b[37GPromise (\u001b[38;2;177;185;249mmain.pr\u001b[39m,\u001b[55G~57\u001b[59Glines).\u001b[67GIt:\r\u001b[2C\u001b[1B-\u001b[5Gtakes\u001b[11Gfile\u001b[16Gpaths\u001b[22Gas\u001b[25Gargs,\u001b[31Gfans\u001b[36Gout\u001b[40G\u001b[1mone goroutine per file\u001b[63G\u001b[22m(\u001b[38;2;177;185;249mgo count_file(...)\u001b[83G\u001b[39m→\u001b[85G\u001b[38;2;177;185;249mTask[FileResult]\u001b[39m),\r\u001b[2C\u001b[1B- counts newlines\u001b[21Gper\u001b[25Gfile\u001b[30G(matches\u001b[39G\u001b[38;2;177;185;249mwc -l\u001b[39m),\u001b[47Gfans\u001b[52Gback\u001b[57Gin\u001b[60Gawaiting\u001b[69Gtasks\u001b[75Gin\u001b[78Gargument\u001b[87Gorder\u001b[93Gso\u001b[96Goutput\u001b[103Gis\u001b[106Gdeterministic\r\u001b[2C\u001b[1Bdespite\u001b[11Gthe\u001b[15Graces,\r\u001b[2C\u001b[1B-\u001b[5Gm\u001b[7Gdels \u001b[13Gach per\u001b[21Gfile outcome\u001b[34Gas\u001b[37Gan \u001b[38;2;177;185;249menum FileResult { Counted, Skipped }\u001b[77G\u001b[39mso\u001b[80G\"skip\u001b[86Gunreadable\u001b[97Gfiles\u001b[103Ggracefully\"\u001b[115Gis\u001b[118Gan\r\u001b[2C\u001b[1Bexh\u001b[7Gustive, compiler-enforced \u001b[38;2;177;185;249mmatch\u001b[39m branch rather than an ad-hoc error path — one\u001b[85Gbad path goes to stderr\u001b[109Gand\u001b[113Gthe\u001b[117Grun\r\u001b[2C\u001b[1Bconti\u001b[9Gues,\u001b[K\r\u001b["]
