[0.103, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m5\u001b[10G\u001b[22mcounts newlines in each (matching `wc -l\u001b[52G,\u001b[54Gthen fans back in —\u001b[75Gwaiting the tasks\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22min arg\u001b[17Gment order so th\u001b[35Gr\u001b[37Gport is determinis\u001b[56Gic even though the reads race — and\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m7\u001b[10G\u001b[22mpri\u001b[17Ga per-file count\u001b[34Gplus a grand total.\u001b[54GUnread\u001b[61Gble files are h\u001b[77Gndled\u001b[83Gby turning\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mthe I/O \u001b[19Grror into a\u001b[31G`Skipped` enum *value* (never a raised error), so\u001b[81Gone bad path\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22mis reported on stderr and skipped ins\u001b[48Gead of aborting the run. Dat\u001b[77G go\u001b[81Gs\u001b[83Gto\u001b[86Gstdout,\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22mdiagnostics to s\u001b[27Gderr, so the totals stay clean when\u001b[63Ga file\u001b[70Gis skipped.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +48 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mLet me clean up\u001b[19Gthe\u001b[23Gtemp\u001b[28Gfiles\u001b[34Gand\u001b[38Gconfirm\u001b[46Gthe\u001b[50Gfinal\u001b[56Gstate\u001b[62Gof\u001b[65Gthe\u001b[69Grun\u001b[73Gdirectory.\r\u001b[2B "]
[0.000, "o", "\u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mDone. Here's what I built\u001b[29Gand\u001b[33Ghow\u001b[37Git\u001b[40Gwent.\r\u001b[2B \u001b[3G\u001b[1mWhat I built\u001b[16G\u001b[22m\u001b[K\r\u001b[2C\u001b[2BA concurrent\u001b[16Gline-counting\u001b[30GCLI\u001b[34Gin\u001b[37GPromise\u001b[45G(\u001b[38;2;177;185;249mmain.pr\u001b[39m,\u001b[55G~57\u001b[59Glines).\u001b[67GIt:\r\u001b[2C\u001b[2B-\u001b[5Gtakes file\u001b[16Gpaths as args, fans out \u001b[1mone goroutine per file\u001b[22m (\u001b[38;2;177;185;249mgo count_file(...)\u001b[83G\u001b[39m→\u001b[85G\u001b[38;2;177;185;249mTask[FileResult]\u001b[39m),\r\u001b[2C\u001b[1B-\u001b[5Gcounts\u001b[12Gnewlines\u001b[21Gper\u001b[25Gfile\u001b[30G(matches\u001b[39G\u001b[38;2;177;185;249mwc -l\u001b[39m),\u001b[47Gfans\u001b[52Gback\u001b[57Gin\u001b[60Gawaiting\u001b[69Gtasks\u001b[75Gin\u001b[78Gargument\u001b[87Gorder\u001b[93Gso\u001b[96Goutput\u001b[103Gis\u001b[106Gdeterministic\r\u001b[2C\u001b[1Bdespite\u001b[11Gthe races,\u001b[22G\u001b[K\r\u001b[4C\u001b[1Bm\u001b[7Gdel\u001b[12Geach p\u001b[19Gr-file outco\u001b[32Ge as an \u001b[38;2;177;185;249menum FileResult { Counted, Skipped }\u001b[39m so \"skip un\u001b[89Geadable files\u001b[103Ggrac\u001b[108Gfully\" is an\r\u001b[2C\u001b[1Bexhaustive,\u001b[15Gcompiler-enforced\u001b[33G\u001b[38;2;177;185;249mmatch\u001b[39G\u001b[3"]
[0.000, "o", "9mbranch\u001b[46Grather\u001b[53Gthan\u001b[58Gan\u001b[61Gad-hoc\u001b[68Gerror\u001b[74Gpath\u001b[79G—\u001b[81Gone\u001b[85Gbad\u001b[89Gpath\u001b[94Ggoes\u001b[99Gto\u001b[102Gstderr\u001b[109Gand\u001b[113Gthe\u001b[117Grun\r\u001b[2C\u001b[1Bcontinues,\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
