[0.000, "o", "38;2;177;185;249mmain.pr\u001b[39m,\u001b[55G~57\u001b[59Glines).\u001b[67GIt:\r\u001b[2C\u001b[1B-\u001b[5Gtakes\u001b[11Gfile\u001b[16Gpaths\u001b[22Gas\u001b[25Gargs,\u001b[31Gfans\u001b[36Gout\u001b[40G\u001b[1mone goroutine per file\u001b[63G\u001b[22m(\u001b[38;2;177;185;249mgo count_file(...)\u001b[83G\u001b[39m→\u001b[85G\u001b[38;2;177;185;249mTask[FileResult]\u001b[39m),\r\u001b[2C\u001b[1B-\u001b[7Gunts newlines per f\u001b[27Gle\u001b[30G(matches \u001b[38;2;177;185;249mwc -l\u001b[39m), fans back in awaiting tasks\u001b[75Gin\u001b[78Gargument\u001b[87Gorder\u001b[93Gso\u001b[96Goutput\u001b[103Gis\u001b[106Gdeterministic\r\u001b[2C\u001b[1Bdespite\u001b[11Gthe\u001b[15Graces,\r\u001b[4C\u001b[1Bmod\u001b[9Gls each per-file outcome as an\u001b[40G\u001b[38;2;177;185;249menum FileResult { Counted,\u001b[67GSkipped }\u001b[39m so \"skip unreadable files gracefully\"\u001b[115Gis\u001b[118Gan\r\u001b[2C\u001b[1Bexha\u001b[8Gs\u001b[10Give, compiler-enforced \u001b[38;2;177;185;249mmatch\u001b[39G\u001b[39mbranch rather than an ad-hoc error path — on\u001b[84G bad path goes to stderr and the run\r\u001b[2C\u001b[1Bcont\u001b[8Gnues,\u001b[K\r\u001b[4C\u001b[1Bkeeps data on stdout\u001b[26Gand diagnostics on stderr, so the grand total stays clean whe\u001b[88G a file is skipped.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BScaffolded\u001b[14Gwith\u001b[19G\u001b[38"]
