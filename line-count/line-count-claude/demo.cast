[0.020, "o", "\u001b[H\r\u001b[1B\u001b[38;2;215;119;87m╭───\u001b[6GClaude Code\u001b[18G\u001b[38;2;153;153;153mv2.1.193\u001b[27G\u001b[38;2;215;119;87m─────────────────────────────────────────────────────────────────────────────────────────────╮\r\u001b[1B│\u001b[54G\u001b[2m│\u001b[56G\u001b[22m\u001b[1mWhat's new\u001b[120G\u001b[22m│\r\u001b[1B│\u001b[18G\u001b[39m\u001b[1mWelcome back George!\u001b[54G\u001b[22m\u001b[2m\u001b[38;2;215;119;87m│\u001b[56G\u001b[39m\u001b[22mBug\u001b[60Gfixes\u001b[66Gand\u001b[70Greliability\u001b[82Gimprovements\u001b[120G\u001b[38;2;215;119;87m│\r\u001b[1B│\u001b[54G\u001b[2m│\u001b[56G\u001b[39m\u001b[22mAdded\u001b[62Ggateway\u001b[70Gspend-limit\u001b[82Gsupport\u001b[90Gto\u001b[93GClaude\u001b[100GCode's\u001b[107Gusage\u001b[113Gwarni…\u001b[120G\u001b[38;2;215;119;87m│\r\u001b[1B│\u001b[24G▗\u001b[48;2;215;119;87m\u001b[38;2;0;0;0m ▗   ▖ \u001b[49m\u001b[38;2;215;119;87m▖\u001b[54G\u001b[2m│\u001b[56G\u001b[39m\u001b[22mAdded\u001b[62Ga\u001b[64Gworkspace\u001b[74Gtrust\u001b[80Gprompt\u001b[87Gto\u001b[90G`claude\u001b[98Gagents`\u001b[106Gfor\u001b[110Guntruste…\u001b[120G\u001b[38;2;215;119;87m│"]
[0.000, "o", "\r\u001b[1B│\u001b[25G\u001b[39m\u001b[48;2;215;119;87m       \u001b[54G\u001b[49m\u001b[2m\u001b[38;2;215;119;87m│\u001b[56G\u001b[22m\u001b[38;2;153;153;153m\u001b[3m/release-notes for more\u001b[120G\u001b[23m\u001b[38;2;215;119;87m│\r\u001b[1B│\u001b[26G▘▘ ▝▝\u001b[54G\u001b[2m│\u001b[120G\u001b[22m│\r\u001b[1B│\u001b[8G\u001b[38;2;153;153;153mOpus 4.8 (1M context) · Claude Max · \u001b[54G\u001b[2m\u001b[38;2;215;119;87m│\u001b[120G\u001b[22m│\r\u001b[1B│\u001b[8G\u001b[38;2;153;153;xxxxxxxxxxxxxxxxxxx@gmail.com's Organization\u001b[54G\u001b[2m\u001b[38;2;215;119;87m│\u001b[120G\u001b[22m│\r\u001b[1B│\u001b[8G\u001b[38;2;153;153;153m~/prog/zoo/line-count/line-count-claude\u001b[54G\u001b[2m\u001b[38;2;215;119;87m│\u001b[120G\u001b[22m│\r\u001b[1B╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\r\u001b[1C\u001b[2B\u001b[39m\u001b[2m▎\u001b[4G\u001b[22m\u001b[38;2;153;153;153m/remote-control is active · Continue here, on yo"]
