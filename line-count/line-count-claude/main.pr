use io;
use os;

// The outcome of counting one file: either a line count, or the reason we
// couldn't read it. Failures are values, not raised errors, so a single
// unreadable path never aborts the whole run.
enum FileResult {
  Counted(string path, int lines),
  Skipped(string path, string reason),
}

// Read one file and count its lines (newline characters, like `wc -l`).
// Runs on its own goroutine; any I/O error is captured into a Skipped result
// rather than propagated, so the caller can report it and carry on.
count_file(string move path) FileResult {
  string content = io.File.read_content(path)? e {
    return FileResult.Skipped(path: path.clone(), reason: e.message.clone());
  };

  int lines = 0;
  for c in content {
    if c == '\n' {
      lines += 1;
    }
  }
  return FileResult.Counted(path: move path, lines: lines);
}

main() {
  string[] paths = os.args;
  if paths.is_empty {
    print_line("usage: line-count <file>...");
    return;
  }

  // Fan out: one goroutine per file, all reading concurrently.
  Task[FileResult][] tasks = [];
  for path in paths {
    tasks.push(go count_file(path.clone()));
  }

  // Fan in: await each task and tally the grand total. We await in argument
  // order, so the report is deterministic even though the reads race.
  int total = 0;
  for t in tasks {
    result := <-t;
    match result {
      FileResult.Counted(path, lines) => {
        print_line("{lines}\t{path}");
        total += lines;
      },
      FileResult.Skipped(path, reason) => {
        print_line("skipped\t{path} ({reason})");
      },
    }
  }
  print_line("{total}\ttotal");
}
