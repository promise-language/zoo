// minigit — a small content-addressed version control tool.
//
//   main       parses argv and maps failures onto exit codes  (this file)
//   commands   one function per subcommand                    (commands.pr)
//   store      the .minigit directory on disk                 (store.pr)
//   commit     the commit record and its text format          (commit.pr)
//   hash       FNV-1a content addressing                      (hash.pr)
//   text       shared line-format helpers                     (text.pr)
//   errors     MiniGitError and its exit statuses             (errors.pr)

// A project's .pr files share one scope, so every module the project uses is
// imported once, here, and reached as `io.`/`path.`/... from any file
// (see BUG-duplicate-use-across-project-files.md).
use io;
use os;
use path;
use time;

main() {
  run(os.args)? failure {
    int status = 1;
    if failure is MiniGitError {
      status = failure.status;
    }
    // If even the diagnostic cannot be written there is nothing left to
    // report it with — the exit status below still carries the failure.
    stderr.write_line("minigit: {failure.message}")? {
    };
    os.exit_process(status);
  };
}

run!(string[] args) {
  if args.is_empty {
    raise usage_error("expected a command\n{usage_text()}");
  }

  string command = args[0];
  string[] rest = args[1:];

  match command {
    "init" => cmd_init(rest),
    "add" => cmd_add(rest),
    "rm" => cmd_rm(rest),
    "status" => cmd_status(rest),
    "commit" => cmd_commit(rest),
    "log" => cmd_log(rest),
    "show" => cmd_show(rest),
    "diff" => cmd_diff(rest),
    "checkout" => cmd_checkout(rest),
    "reset" => cmd_reset(rest),
    "help" => print_line(usage_text()),
    _ => {
      raise usage_error("unknown command '{command}'\n{usage_text()}");
    },
  }
}

usage_text() string `public {
  return """usage: minigit <command> [arguments]

  init                        create the .minigit repository here
  add <file>                  store a file as a blob and stage its name
  rm <file>                   unstage a filename
  status                      list the staged filenames
  commit -m "<message>"       record the staged files as a commit
  log                         show the commit chain, newest first
  show <commit>               show one commit and its files
  diff <commit-a> <commit-b>  compare two commits' file sets
  checkout <commit>           restore a commit's files into the working directory
  reset <commit>              move the current commit, keep the working files""";
}
