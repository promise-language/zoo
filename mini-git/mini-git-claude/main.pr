// mini-git — a small content-addressed version control tool.
//
// Everything lives under .minigit/ in the current directory:
//
//   objects/<hash>   blob — the raw bytes of an added file, named by their hash
//   commits/<id>     commit — header lines, a blank line, then the message
//   HEAD             id of the current commit (empty until the first commit)
//   index            staging area — one "<hash> <name>" line per staged file
//
// Content addressing is FNV-1a/64 over raw bytes, rendered as 16 lowercase hex
// digits. A commit's id is the hash of its own serialized body, so ids are
// reproducible across runs. Every listing is sorted by name, so the output is
// deterministic.
use io;
use os;
use path;
use time;

// ---------------------------------------------------------------------------
// Layout
// ---------------------------------------------------------------------------

get repo_dir string => ".minigit";
get objects_dir string => path.join(repo_dir, "objects");
get commits_dir string => path.join(repo_dir, "commits");
get head_path string => path.join(repo_dir, "HEAD");
get index_path string => path.join(repo_dir, "index");

/// Width of a rendered hash, in hex digits. FNV-1a/64 → 16.
get hash_width int => 16;

get exit_error int => 1;
get exit_usage int => 2;

// ---------------------------------------------------------------------------
// Hashing
// ---------------------------------------------------------------------------

/// FNV-1a (64-bit) over raw bytes — deterministic, and no dependency needed.
/// The multiply overflows on purpose; u64 arithmetic wraps.
hash_bytes(u8[] data) string {
  u64 h = 14695981039346656037u64; // FNV-1a offset basis
  for b in data {
    h = h ^ (b as u64);
    h = h * 1099511628211u64; // FNV-1a prime
  }
  return h.to_string(base: 16, width: hash_width, fill: '0');
}

hash_string(string s) string => hash_bytes(s.bytes());

// ---------------------------------------------------------------------------
// Model
// ---------------------------------------------------------------------------

/// One tracked file: its working-tree name and the hash of its blob.
/// Ordered by name, so `sort` gives us the deterministic listing order.
type Entry {
  string name;
  string hash;

  == (Entry other) bool => this.name == other.name && this.hash == other.hash;
  < (Entry other) bool => this.name < other.name;
}

/// The canonical serialization of a commit. Hashing this yields the commit id,
/// so it must stay stable: fixed header order, sorted files, then the message.
commit_body(string parent, string timestamp, string message, Entry[] files) string {
  Builder b = Builder();
  b.write_string("parent {parent}\n");
  b.write_string("time {timestamp}\n");
  for e in files {
    b.write_string("file {e.hash} {e.name}\n");
  }
  b.write_string("\n{message}"); // a blank line separates the header from the message
  return b.to_string();
}

/// A commit: a snapshot of the staged files, plus who came before it.
type Commit {
  string id `final;
  string parent; // "" for the root commit
  string timestamp;
  string message;
  Entry[] files; // always sorted by name

  /// Build a commit and derive its id by hashing its own body.
  /// Everything is consumed — the commit owns its entries and strings from here on.
  /// `files` must be `move`: sorting a *borrowed* vector and storing the result in a
  /// field double-frees it — see BUG-sort-borrowed-vector-double-free.md.
  record(string move parent, string move timestamp, string move message, Entry[] move files) Commit `factory {
    Entry[] sorted = sort(files);
    string body = commit_body(parent, timestamp, message, sorted);
    return Commit(id: hash_string(body),
    parent: move parent,
    timestamp: move timestamp,
    message: move message,
    files: move sorted);
  }

  /// The exact text stored in commits/<id> — and the text its id hashes.
  get body string => commit_body(this.parent, this.timestamp, this.message, this.files);
}

/// Parse a commit back from the text written by `commit_body`.
parse_commit!(string id, string text) Commit {
  int? split_at = text.index_of("\n\n");
  if split_at is absent {
    raise error(message: "commit {id} is corrupt: no header/message separator");
  }
  // the raise above diverges, so `split_at` is narrowed to a plain int from here on
  string header = text[0:split_at];
  string message = text[split_at + 2:];

  string parent = "";
  string timestamp = "";
  Entry[] files = [];

  for line in header.split("\n") {
    if line.starts_with("parent ") {
      parent = line[7:];
    } else if line.starts_with("time ") {
      timestamp = line[5:];
    } else if line.starts_with("file ") {
      string rest = line[5:]; // "<hash> <name>"
      files.push(Entry(hash: rest[0:hash_width], name: rest[hash_width + 1:]));
    } else {
      raise error(message: "commit {id} is corrupt: bad header line '{line}'");
    }
  }
  return Commit(id: id.clone(),
  parent: move parent,
  timestamp: move timestamp,
  message: move message,
  files: move files);
}

// ---------------------------------------------------------------------------
// Storage
// ---------------------------------------------------------------------------

blob_path(string hash) string => path.join(objects_dir, hash);

read_file_bytes!(string p) u8[] {
  int size = io.File.size(p);
  u8[] buf = u8[].filled(0u8, count: size);
  if size == 0 {
    return buf;
  }
  io.File f = io.File.open(p, readonly: true);
  f.read(buf);
  f.close();
  return buf;
}

write_file_bytes!(string p, u8[] ~data) {
  io.File f = io.File.create(p);
  f.write(data);
  f.close();
}

read_blob!(Entry e) u8[] {
  string p = blob_path(e.hash);
  if !io.File.exists(p) {
    raise error(message: "blob {e.hash} for '{e.name}' is missing from the object store");
  }
  return read_file_bytes(p);
}

/// The staging area, as name → blob hash.
read_index!() map[string, string] {
  map[string, string] staged = {:};
  if !io.File.exists(index_path) {
    return staged;
  }
  for line in io.File.read_content(index_path).split("\n") {
    if line.is_empty {
      continue;
    }
    staged[line[hash_width + 1:]] = line[0:hash_width]; // "<hash> <name>"
  }
  return staged;
}

write_index!(map[string, string] staged) {
  Builder b = Builder();
  for name in sort[string](staged.keys()) {
    b.write_string("{staged[name]!} {name}\n");
  }
  io.File.write_content(index_path, b.to_string());
}

clear_index!() {
  io.File.write_content(index_path, "");
}

read_head!() string {
  if !io.File.exists(head_path) {
    return "";
  }
  return io.File.read_content(head_path).trim();
}

write_head!(string id) {
  io.File.write_content(head_path, "{id}\n");
}

load_commit!(string id) Commit {
  string p = path.join(commits_dir, id);
  if !io.File.exists(p) {
    raise error(message: "unknown commit '{id}'");
  }
  return parse_commit(id, io.File.read_content(p));
}

require_repo!() {
  if !io.Dir.exists(repo_dir) {
    raise error(message: "not a minigit repository — run 'minigit init' first");
  }
}

// ---------------------------------------------------------------------------
// Commands
// ---------------------------------------------------------------------------

cmd_init!() {
  if io.Dir.exists(repo_dir) {
    print_line("minigit: repository already exists at {repo_dir}/");
    return; // already initialized is not an error — exit cleanly
  }
  io.Dir.make_all(objects_dir);
  io.Dir.make_all(commits_dir);
  write_head("");
  clear_index();
  print_line("initialized empty minigit repository in {repo_dir}/");
}

cmd_add!(string name) {
  require_repo();
  if !io.File.exists(name) {
    raise error(message: "no such file: '{name}'");
  }

  u8[] data = read_file_bytes(name);
  string hash = hash_bytes(data);
  write_file_bytes(blob_path(hash), data); // identical bytes reuse the same blob

  map[string, string] staged = read_index();
  staged[name] = hash.clone(); // the map takes its own copy; we still print ours
  write_index(staged);

  print_line("added {name} ({hash})");
}

cmd_rm!(string name) {
  require_repo();
  map[string, string] staged = read_index();
  if !staged.contains(name) {
    raise error(message: "'{name}' is not staged");
  }
  staged.remove(name);
  write_index(staged);
  print_line("unstaged {name}");
}

cmd_status!() {
  require_repo();
  map[string, string] staged = read_index();
  if staged.is_empty {
    print_line("nothing staged");
    return;
  }
  print_line("staged files:");
  for name in sort[string](staged.keys()) {
    print_line("  {staged[name]!}  {name}");
  }
}

cmd_commit!(string message) {
  require_repo();
  map[string, string] staged = read_index();
  if staged.is_empty {
    raise error(message: "nothing staged to commit");
  }

  Entry[] files = [];
  for name, hash in staged {
    files.push(Entry(name: name.clone(), hash: hash.clone()));
  }

  Commit c = Commit.record(parent: read_head(),
  timestamp: time.DateTime.now().format_rfc3339(),
  message: message.clone(),
  files: move files);

  io.File.write_content(path.join(commits_dir, c.id), c.body);
  write_head(c.id);
  clear_index(); // committing empties the staging area

  print_line("committed {c.id} ({c.files.len} file(s))");
}

cmd_log!() {
  require_repo();
  string id = read_head();
  if id.is_empty {
    print_line("no commits yet");
    return;
  }
  while !id.is_empty {
    Commit c = load_commit(id);
    print_line("commit {c.id}");
    print_line("date   {c.timestamp}");
    print_line("");
    print_line("    {c.message}");
    print_line("");
    id = c.parent; // walk back — newest first
  }
}

cmd_show!(string id) {
  require_repo();
  Commit c = load_commit(id);
  print_line("commit {c.id}");
  print_line("date   {c.timestamp}");
  if !c.parent.is_empty {
    print_line("parent {c.parent}");
  }
  print_line("");
  print_line("    {c.message}");
  print_line("");
  print_line("files:");
  for e in c.files {
    print_line("  {e.hash}  {e.name}");
  }
}

/// Compare two commits by blob hash: same name and same hash means unchanged.
cmd_diff!(string id_a, string id_b) {
  require_repo();
  Commit a = load_commit(id_a);
  Commit b = load_commit(id_b);

  map[string, string] old = {:};
  for e in a.files {
    old[e.name] = e.hash;
  }
  map[string, string] new_ = {:};
  for e in b.files {
    new_[e.name] = e.hash;
  }

  // Walk the union of both file sets in name order, so the report is stable.
  string[] names = old.keys();
  for name in new_.keys() {
    if !old.contains(name) {
      names.push(name.clone());
    }
  }
  names = sort(names);

  int changes = 0;
  for name in names {
    bool in_a = old.contains(name);
    bool in_b = new_.contains(name);
    if !in_a {
      print_line("added     {name}  {new_[name]!}");
    } else if !in_b {
      print_line("removed   {name}  {old[name]!}");
    } else if old[name]! != new_[name]! {
      print_line("modified  {name}  {old[name]!} -> {new_[name]!}");
    } else {
      continue; // same name, same blob hash — unchanged
    }
    changes += 1;
  }
  if changes == 0 {
    print_line("no changes");
  }
}

/// Restore every file the commit recorded, then move HEAD onto it.
cmd_checkout!(string id) {
  require_repo();
  Commit c = load_commit(id);
  for e in c.files {
    u8[] data = read_blob(e);
    write_file_bytes(e.name, data);
  }
  write_head(c.id);
  clear_index();
  print_line("checked out {c.id} ({c.files.len} file(s) restored)");
}

/// Like checkout, but leaves the working directory alone.
cmd_reset!(string id) {
  require_repo();
  Commit c = load_commit(id);
  write_head(c.id);
  clear_index();
  print_line("reset to {c.id} (working directory untouched)");
}

// ---------------------------------------------------------------------------
// CLI
// ---------------------------------------------------------------------------

usage() {
  print_line("""minigit — a tiny content-addressed version control tool

usage:
  minigit init                        create the repository
  minigit add <file>                  hash a file into the store and stage it
  minigit rm <file>                   unstage a file
  minigit status                      list the staged files
  minigit commit -m "<message>"       record the staged files as a commit
  minigit log                         show the commit chain, newest first
  minigit show <commit>               show one commit and its files
  minigit diff <commit-a> <commit-b>  compare two commits
  minigit checkout <commit>           restore the working directory to a commit
  minigit reset <commit>              move HEAD only, leaving files as they are""");
}

/// Positional argument `i`, or a usage error naming what was missing.
arg!(string[] argv, int i, string what) string {
  if i >= argv.len {
    raise error(message: "{argv[0]}: missing <{what}>");
  }
  return argv[i].clone();
}

// Every arm is a { block }, never a bare `=> call()`. A bare failable call in a
// match *expression* arm silently discards its error — see BUG-match-arm-*.md.
dispatch!(string[] argv) {
  string cmd = argv[0];
  match cmd {
    "init" => {
      cmd_init();
    },
    "add" => {
      cmd_add(arg(argv, 1, "file"));
    },
    "rm" => {
      cmd_rm(arg(argv, 1, "file"));
    },
    "status" => {
      cmd_status();
    },
    "commit" => {
      if argv.len < 3 || argv[1] != "-m" {
        raise error(message: "usage: minigit commit -m \"<message>\"");
      }
      cmd_commit(argv[2]);
    },
    "log" => {
      cmd_log();
    },
    "show" => {
      cmd_show(arg(argv, 1, "commit"));
    },
    "diff" => {
      cmd_diff(arg(argv, 1, "commit-a"), arg(argv, 2, "commit-b"));
    },
    "checkout" => {
      cmd_checkout(arg(argv, 1, "commit"));
    },
    "reset" => {
      cmd_reset(arg(argv, 1, "commit"));
    },
    _ => {
      print_line("minigit: unknown command '{cmd}'");
      usage();
      os.exit_process(exit_usage);
    },
  }
}

main() {
  string[] argv = os.args;
  if argv.is_empty {
    usage();
    os.exit_process(exit_usage);
  }
  dispatch(argv)? e {
    print_line("minigit: {e.message}");
    os.exit_process(exit_error);
  };
}
