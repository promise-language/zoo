[0.022, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m5\u001b[9G\u001b[22m`prom\u001b[15Gse versio\u001b[25G 2026.6 (channel stable)` · macOS 26.5.1 (arm64, Apple Silicon)\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m6\r\u001b[6C\u001b[1B7\u001b[9G\u001b[22m## Minimal \u001b[21Gepro\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m8\r\u001b[6C\u001b[1B9\u001b[9G\u001b[22m`cha\u001b[15G_string_len.pr` — optional chain into a built-in getter (`string.len`):\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +111 lines \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(BUG-bare-call-on-tuple-returning-failable.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m83\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1mBUG-bare-call-on-tuple-returning-failable.md\r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m  1 \u001b[22mPlease file this upstream at https://github.com/promise-language/promise/issues\r\u001b[1B\u001b[39m     \u001b[38;2;248;248;242m\u001b[2m  2 \u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m3\u001b[10G\u001b[22m# A bare call to\u001b[27Ga tuple-re\u001b[38Gurning failable functi\u001b[61Gn d\u001b[65Gstructur\u001b[74Gs into (value, error) instead of propaga\r\u001b[7C\u001b[1B\u001b[2m \u001b[10G\u001b[2"]
[0.000, "o", "2mting — unlike `?^`, which the guide calls equivalent\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m6\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m7\u001b[10G\u001b[22m`promise guide` documents `foo()?^` as \"Explicit propagate (same as bare call)\".\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mFor a failable function that returns a tuple the two forms are *not* the same:\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22mthe bar\u001b[19Gcall is swallowed by the \"c\u001b[47Gpture raw failable r\u001b[68Gsult as `(v\u001b[80Glue, error)`\"\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22mrule,\u001b[16Gso a two-element destructuri\u001b[45Gg\u001b[47Gbinds `(\u001b[59Gwh\u001b[62Gle tuple, err\u001b[76Gr)` instead of\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +76 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(BUG-trailing-comma-rejected-in-argument-lists.md)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[0.015, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;248;248;242m\u001b[2m  3 \u001b[22m# A bare call to a tuple-returning failable function destructures into (value, error) instead of propaga\r\u001b[6C\u001b[1B\u001b[2m \u001b[9G \u001b[22mting — unlike `?^`, which the guide calls equivalent\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 4 \r\u001b[6C\u001b[1B 6 \u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 7 \u001b[22m`promise guide` documents `foo()?^` as \"Explicit propagate (same as bare call)\".\r\u001b[6C\u001b[1B\u001b[2m 8 \u001b[22mFor a failable function that returns a tuple\u001b[55Gthe \u001b[60Gwo forms are *not* th\u001b[82G same:\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22mthe bare call is swallowed by the \"capture raw failable result as `(value, error)`\"\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22mrule, so a two-element destructuring binds `(the whole tuple, error)` instead of\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m… +76 lines \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(BUG-trailing-comma-rejected-in-argument-lists.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m81\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1mBUG-trailing-comma-rejected-in-argumen"]
[0.000, "o", "t-lists.md\r\u001b[6C\u001b[1B\u001b[22m\u001b[38;2;248;248;242m\u001b[2m1 \u001b[22mPlease file this ups\u001b[30Gream at https://g\u001b[48Gthub.com/promise-language/promise/iss\u001b[87Gs\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m2\u001b[9G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m3 \u001b[22m# Trailing commas are accepted in collection literals, match arms and enum bodies, but rejected in call, \r\u001b[7C\u001b[1B\u001b[2m \u001b[22mconstructor, parameter and tuple lists\r\u001b[6C\u001b[1B\u001b[2m4 \u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m5 \u001b[22m`promise version 2026.6 (c\u001b[37Gnnel stable)` · macOS\u001b[59G26.5.1 (arm64, Apple Silicon)\r\u001b[6C\u001b[1B\u001b[2m6 \u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m7 \u001b[22m## Minimal repro\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 8 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 9 \u001b[22m`call_trailing_comma.pr`:\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m… +73 lines \u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
