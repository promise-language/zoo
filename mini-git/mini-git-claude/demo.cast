[0.000, "o", "nstead\u001b[76Gof\u001b[79Gpropagating\u001b[91G—\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m11\u001b[14G\u001b[38;2;248;248;242msee BUG-bare-call-on-tuple-returning-failable.md. \u001b[65G               \u001b[81G        \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[11G\u001b[38;2;248;248;242msplit_first!(string line, \u001b[40Ging s\u001b[46Gpara\u001b[52Gr) (string, string) `public {         \u001b[91G \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m3\u001b[11G\u001b[38;2;248;248;242m  \u001b[14G if\u001b[18Gat := line.index_of(s\u001b[40Gparator) {             \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[11G\u001b[38;2;248;248;242m        \u001b[20Ge\u001b[22Gurn (line[0:at], l\u001b[42Ge[at + separator.len:]);     \u001b[72G       \u001b[80G \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 15 \u001b[22m     }\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m6\u001b[15G\u001b[38;2;248;248;242mraise repo_error(\"m\u001b[35Glformed line (ex\u001b[52Gected '{separator}'):\u001b[74G{line}\");\r\u001b[7C\u001b[1B\u001b[49m\u001b[2m7\u001b[11G\u001b[22m}\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 18 \u001b[22m \u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m9\u001b[11G\u001b[22m// Filenames in sorted order. Every listing minigit prints goes through here, so\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m8\u001b"]
[0.000, "o", "[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mNow the upstream reports.\u001b[29GFirst\u001b[35Gthe\u001b[39Gmost\u001b[44Gserious\u001b[52Gone:\r\u001b[2B\u001b[38;2;153;153;153m \u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(BUG-optional-chain-into-ge\u001b[36Gt\u001b[38Gr.md)\u001b[44G\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[0.027, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 14 +\u001b[38;2;248;248;242m        return (line[0:at], line[at + separator.len:]);                                                \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 15 \u001b[22m     }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 16 +\u001b[38;2;248;248;242m    raise repo_error(\"malformed line (expected '{separator}'): {line}\");                               \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 17 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 18 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 19 \u001b[22m // Filenames in sorted order. Every listing minigit prints goes through here, so\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m8\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mNow the upstream reports. First the most serious one:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(BUG-optional-chain-into-getter.md)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m116\u001b[22m lines\u001b[22Gto\u001b[25G\u001b[1mBUG-optional-chain-into-getter.md\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;2;248;248;242m\u001b[2m"]
