[0.135, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(main.pr)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 20 \u001b[22m     run(os.args) ? failure {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 21 \u001b[22m         int status = 1;\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 22 \u001b[22m         if failure is MiniGitError { status = failure.status; }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 23 -\u001b[38;2;248;248;242m        stderr.write_line(\"minigit: {failure.message}\");                                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 23 +\u001b[38;2;248;248;242m        // If even the diagnostic cannot be written there is nothing left to                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 24 +\u001b[38;2;248;248;242m        // report it with — the exit status below still carries the failure.                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 2"]
[0.000, "o", "5 +\u001b[38;2;248;248;242m        stderr.write_line(\"minigit: {failure.message}\") ? { };                                         \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;248;248;242m\u001b[2m 26 \u001b[22m         os.exit_process(status);\r\u001b[5C\u001b[1B\u001b[2m 27 \u001b[22m     };\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m 28 \u001b[22m }\u001b[13G\u001b[39m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mCompiles. Now an end-to-end run:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39mRunning \u001b[1m2\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ promise exec 'use path; main() { print_line(path.normalize(path.join(\".\", \".minigit\"))); }'\r\u001b[2C\u001b[2B\u001b[38;2;235;159;127mBrewing…\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
