[0.000, "o", "\u001b[1B\u001b[38;2;80;200;80m10\u001b[14G\u001b[38;2;248;248;242mfunction\u001b[23Ga\u001b[25Gbare\u001b[30Gcall\u001b[35Gdestructures\u001b[48Ginto\u001b[53G(value,\u001b[61Gerror)\u001b[68Ginstead\u001b[76Gof\u001b[79Gpropagating\u001b[91G—\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m11\u001b[14G\u001b[38;2;248;248;242msee BUG-bare-call-on-tuple-returning-failable.md. \u001b[65G               \u001b[81G        \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[11G\u001b[38;2;248;248;242msplit_first!(string line, \u001b[40Ging s\u001b[46Gpara\u001b[52Gr) (string, string) `public {         \u001b[91G \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m3\u001b[11G\u001b[38;2;248;248;242m  \u001b[14G if\u001b[18Gat := line.index_of(s\u001b[40Gparator) {             \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[11G\u001b[38;2;248;248;242m        \u001b[20Ge\u001b[22Gurn (line[0:at], l\u001b[42Ge[at + separator.len:]);     \u001b[72G       \u001b[80G \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 15 \u001b[22m     }\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m6\u001b[15G\u001b[38;2;248;248;242mraise repo_error(\"m\u001b[35Glformed line (ex\u001b[52Gected '{separator}'):\u001b[74G{line}\");\r\u001b[7C\u001b[1B\u001b[49m\u001b[2m7\u001b[11G\u001b[22m}\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 18 \u001b[22m \u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m9\u001b[11G\u001b[22m/"]
