[0.018, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m4\u001b[15G\u001b[38;2;248;248;242m//\u001b[18Gany\u001b[22Glater ones, so filenam\u001b[45Gs and messages may contain the separator.\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m5\u001b[15G\u001b[38;2;248;248;242mfirst!(string\u001b[29Gline,\u001b[35Gstring\u001b[42Gseparator)\u001b[53GSelf\u001b[58G`factory\u001b[67G{\r\u001b[7C\u001b[1B\u001b[38;2;220;90;90m6\u001b[19G\u001b[38;2;248;248;242mif at\u001b[25G:= line.index_o\u001b[41G(separator) {       \u001b[62G               \u001b[78G         \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 17 -\u001b[38;2;248;248;242m            return Self(head: line[0:at], tail: line[at + separator.len:]);                            \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 18 -\u001b[38;2;248;248;242m        }                                                                                              \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 19 -\u001b[38;2;248;248;242m        raise repo_error(\"malformed line (expected '{separator}'): {line}\");                           \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m6\u001b[14G\u001b[38;2;248;248;242mSp\u001b[17Gits \"<head><separator><tail>\" at the\u001b[54G*first* separator. The tail keeps any"]
[0.000, "o", "\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m 7\u001b[14G\u001b[38;2;248;248;242mlater \u001b[22Ges, so filenam\u001b[38G and mes\u001b[47Gages may contain the\u001b[68Gsepar\u001b[74Gtor themselves. \u001b[91G \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m 8\u001b[14G\u001b[38;2;248;248;242m   \u001b[18G                                             \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m 9\u001b[11G\u001b[38;2;248;248;242m// Calle\u001b[21G mu\u001b[26G propagate\u001b[37Gwith an \u001b[46Gxplicit `?^`: on a \u001b[66Guple-ret\u001b[75Grn\u001b[78Gng failable\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m0\u001b[11G\u001b[38;2;248;248;242m//\u001b[14Gfunction a bare call destructures into\u001b[53G(value,\u001b[61Gerror)\u001b[68Ginstead\u001b[76Gof\u001b[79Gpropagating\u001b[91G—\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[11G\u001b[38;2;248;248;242m//\u001b[14Gsee\u001b[18GBUG-bare-call-on-\u001b[36Guple-r\u001b[43Gturning-f\u001b[53Gilable.md.   \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 12 +\u001b[38;2;248;248;242msplit_first!(string line, string separator) (string, string) `public {                                 \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m3\u001b[15G\u001b[38;2;248;248;242mif at\u001b[21G:= line.index_o\u001b[37G(separator) {       \u001b[58G               \u001b[74G         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 14 +\u001b[38"]
[0.000, "o", ";2;248;248;242m        return (line[0:at], line[at + separator.len:]);                                                \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m5\u001b[11G\u001b[22m    }\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 16 +\u001b[38;2;248;248;242m    raise repo_error(\"malformed line (expected '{separator}'): {line}\");                               \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 17 \u001b[22m }\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m 18 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;248;248;242m\u001b[2m 19 \u001b[22m // Filenames in sorted order. Every listing minigit prints goes through here, so\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m⏺\u001b[3G\u001b[39mRunning \u001b[1m3\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ promise format\u001b[23G*.pr 2>&1 | tail -3; wc -l *.pr; echo; cat main.pr text.pr\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
