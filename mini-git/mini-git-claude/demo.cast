[0.049, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m⏺\u001b[39m \u001b[1mUpdate\u001b[22m(store.pr)\u001b[20G\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m7\u001b[18G\u001b[22mThe\u001b[22Greposi\u001b[29Gory belonging to `directory`. Pure path a\u001b[71Githmetic — this does\r\u001b[7C\u001b[1B\u001b[2m8\u001b[15G\u001b[22m// not touch the filesystem, so it\u001b[50Gis safe to call before `init`.\r\u001b[5C\u001b[1B\u001b[2m 19 \u001b[22m     at(string directory) Self `factory {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 20 -\u001b[38;2;248;248;242m        string root = path.join(directory, \".minigit\");                                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 20 +\u001b[38;2;248;248;242m        string root = path.\u001b[48;2;4;71;0mnormalize(path.\u001b[48;2;2;40;0mjoin(directory, \".minigit\")\u001b[48;2;4;71;0m)\u001b[48;2;2;40;0m;                                \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m1\u001b[19G\u001b[22mretu\u001b[24Gn Self(\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m2\u001b[23G\u001b[22mroot: root.cl"]
