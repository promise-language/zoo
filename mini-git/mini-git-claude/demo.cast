[0.063, "o", "\u001b[?25l\u001b[H\u001b[8G\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m4\u001b[15G\u001b[38;2;248;248;242m//\u001b[18Gany later \u001b[29Gn\u001b[31Gs, so fi\u001b[40Gena\u001b[45Gs\u001b[47Gand messages may contain the separator. \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 15 -\u001b[38;2;248;248;242m    first!(string line, string separator) Self `factory {                                              \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 16 -\u001b[38;2;248;248;242m        if at := line.index_of(separator) {                                                            \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 17 -\u001b[38;2;248;248;242m            return Self(head: line[0:at], tail: line[at + separator.len:]);                            \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 18 -\u001b[38;2;248;248;242m        }                                                                                              \r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m 19 -\u001b[38;2;248;248;242m        raise repo_error(\"malformed line (expected '{separator}'): {line}\");                           \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 6\u001b[14G\u001b[38;2;248;248;242mSplits \"<head><separa\u001b[36Gor>"]
[0.000, "o", "<tail>\" at the *first* separator.\u001b[73GThe\u001b[77Gtail\u001b[82Gkeeps\u001b[88Gany\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m 7\u001b[11G\u001b[38;2;248;248;242m// later ones, so fi\u001b[32Ge\u001b[34Game\u001b[38G and mess\u001b[48Gges may contain\u001b[64Gthe separator themselves.\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m 8\u001b[11G\u001b[38;2;248;248;242m//\u001b[15G  \u001b[18G  \u001b[21G  \u001b[24G                        \u001b[49G \r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m 9\u001b[11G\u001b[38;2;248;248;242m//\u001b[14GCalle\u001b[20Gs must propagate with an explicit `?^`: o\u001b[62G a tuple-returning\u001b[81Gfailable\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 10 +\u001b[38;2;248;248;242m// function a bare call destructures into (value, error) instead of propagating —                      \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m1\u001b[11G\u001b[38;2;248;248;242m//\u001b[14Gsee BUG-bare-call-on-tuple-returning-failable.md.          \u001b[74G         \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 12 +\u001b[38;2;248;248;242msplit_first!(string line, string separator) (string, string) `public {                                 \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 13 +\u001b[38;2;248;248;242m    if at := line.index_of(separator) {                      "]
[0.000, "o", "                                          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 14 +\u001b[38;2;248;248;242m        return (line[0:at], line[at + separator.len:]);                                                \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 15 \u001b[22m     }\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 16 +\u001b[38;2;248;248;242m    raise repo_error(\"malformed line (expected '{separator}'): {line}\");                               \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;248;248;242m\u001b[2m 17 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 18 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 19 \u001b[22m // Filenames in sorted order. Every listing minigit prints goes through here, so\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m⏺\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m7\u001b[13G\u001b[22mshell\u001b[19Gcommands…\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ f\u001b[10Gr f in *.pr; do echo \"===== $f\"; head -12 $f; done\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;235;159;127mBrewing…\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
