[0.046, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m6\u001b[13G\u001b[22mcontent-addressed store needs to be r\u001b[51Gpr\u001b[54Gducible.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m7\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m8\u001b[10G\u001b[22mfnv1a_64(u8[] data) u64 `public {\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m9\u001b[10G\u001b[22m    u64 hash = 0xcbf29ce484222325u64;   // FNV offset basis\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22m    for byte in d\u001b[28Gta {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +11 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(text.pr)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m52\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1mtext.pr\r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m  1 \u001b[22m// Small text helpers shared by the on-disk formats (index file and commits).\r\u001b[1B\u001b[39m     \u001b[38;2;248;248;242m\u001b[2m  2 \u001b[22m// Both formats are line-oriented \"<key> <value>\" text, so they need the same\r\u001b[7C\u001b[1B\u001b[2m3\u001b[13G\u001b[22mthree\u001b[20Ghings: a stable key order, a split at the\u001b[62Gf\u001b[64Grst spac\u001b[73G, and an escape\r\u001b[7C\u001b[1B\u001b[2m4\u001b[13G\u001b[22mf"]
[0.000, "o", "\u001b[15Gr values th\u001b[27Gt could \u001b[36Gth\u001b[39Grwise contain \u001b[54G n\u001b[57Gwlin\u001b[62G.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m6\u001b[13G\u001b[22mFilen\u001b[19Gmes in sorted order — ev\u001b[44Gry listing\u001b[55Gminigit prints goes through here,\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m// so output never depends on map iteration order.\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22msorted_\u001b[22G(map[string, st\u001b[38Ging] \u001b[44Gntrie\u001b[50G) string[] `public {\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m9\u001b[10G\u001b[22m  \u001b[13G string[]\u001b[24Gam\u001b[27Gs\u001b[29G= entries.keys();\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m10\u001b[10G\u001b[22m    return \u001b[22Gort(move \u001b[32Game\u001b[36G);\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +42 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(commit.pr)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[0.016, "o", "\u001b[?25l\u001b[H\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m4\u001b[13G\u001b[22mf\u001b[15Gr values that could oth\u001b[39Grwise contain a newline.\r\u001b[7C\u001b[1B\u001b[2m5\r\u001b[7C\u001b[1B6\u001b[10G\u001b[22m// Filenames in sorted order — every listing minigit prints goes through here,\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m//\u001b[13Gso output\u001b[23Gnever depends on map iteration order.\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 8\u001b[10G\u001b[22msorted_names(map[s\u001b[29Gring, string] entries) string[] `public {\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m    string[] names = entries.keys();\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m    return sort(move names);\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m… +42 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(commit.pr)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m85\u001b[22m lines to \u001b[1mcommit.pr\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m1\u001b[13G\u001b[22mA commit: the\u001b[27Gfile set\u001b[36Gthat was st\u001b[48Gged, \u001b[54Ghe message, when it h\u001b[76Gppened, and\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m2\u001b[13G\u001b[22mthe\u001b[17Gcommit\u001b[24Git followed. The \u001b[42Gd is the hash of th\u001b[62G commit's own serialized\r\u001b[7C"]
[0.000, "o", "\u001b[1B\u001b[2m3\u001b[10G\u001b[22m// text, so nothing outside the commit contributes to its identity.\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m5\u001b[10G\u001b[22mtype C\u001b[17Gmmit `public {\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m6\u001b[10G\u001b[22m    string id `final;\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m7\u001b[20G\u001b[22m? parent\u001b[29G`fi\u001b[33Gal;              // absent for the first commit\r\u001b[6C\u001b[1B\u001b[2m 8\u001b[14G\u001b[22mstring\u001b[21Gtimestamp\u001b[31G`final\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m    string message `final;\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m    map[string, string] files `final;   // filename -> blob hash\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m… +75 lines \u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[0.047, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;248;248;242m\u001b[2m  3 \u001b[22m// three things: a stable key order, a split at the first space, and an escape\r\u001b[3C\u001b[24B\u001b[38;2;215;119;87mr\u001b[27G\u001b[38;2;153;153;153m8\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
