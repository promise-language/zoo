[0.001, "o", "\u001b[0m\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mthen restores precisely that file set. Blobs are read and written as \u001b[0m\u001b[38;5;203;48;5;236m u8[] \u001b[0m\u001b[38;5;252m,\u001b[0m\u001b[38;5;252m not\u001b[0m\r\n\u001b[0m\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mstrings, so binary files survive: a 5 KB random file round-tripped\u001b[0m\u001b[38;5;252m through\u001b[0m\r\n\u001b[0m\u001b[38;5;203;48;5;236m\u001b[0m\u001b[38;5;203;48;5;236m\u001b[0m  \u001b[38;5;203;48;5;236m add \u001b[0m\u001b[38;5;252m → \u001b[0m\u001b[38;5;203;48;5;236m commit \u001b[0m\u001b[38;5;252m → \u001b[0m\u001b[38;5;203;48;5;236m rm \u001b[0m\u001b[38;5;252m → \u001b[0m\u001b[38;5;203;48;5;236m checkout \u001b[0m\u001b[38;5;252m with an identical MD5. Empty\u001b[0m\u001b[38;5;252m files,\u001b[0m\r\n\u001b[0m\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mfilenames containing spaces, and nested paths (\u001b[0m\u001b[38;5;203;48;5;236m nested/deep.txt \u001b[0m\u001b[38;5;252m, whose\u001b[0m\u001b[38;5;252m parent\u001b[0m\r\n\u001b[0m\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mdirectory is recreated on checkout) all\u001b[0m\u001b[38;5;252m work.\u001b[0m\r\n\u001b[38;5;252m\u001b[0m  \u001b[38;5;252m\u001b[0m\r\n\u001b[0m\u001b[38;5;39;1m\u001b[0m\u001b[38;5;39;1m\u001b[0m  \u001b[38;5;39;1m## \u001b[0m\u001b"]
