[0.078, "o", "\u001b[?25l\u001b[H\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mLanguage probes all pass.\u001b[29GNow\u001b[33Gwriting\u001b[41Gthe\u001b[45Greal\u001b[50Gproject.\r\u001b[2B \u001b[3G\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(errors.pr)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m16\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1merrors.pr\r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m  1 \u001b[22m// Every failure minigit reports on its own — carrying the exit status that\r\u001b[1B\u001b[39m     \u001b[38;2;248;248;242m\u001b[2m  2 \u001b[22m// `main` should hand back to the shell.\r\u001b[7C\u001b[1B\u001b[2m3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m4\u001b[10G\u001b[22mtype M\u001b[18GiGitError is error\u001b[37G`public {\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m5\u001b[10G\u001b[22m    int status;\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22m}\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m7\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m8\u001b[10G\u001b[22m// The command was used correctly but could not be carried out (missing file,\r\u001b[7C\u001b[1"]
[0.000, "o", "B\u001b[2m9\u001b[10G\u001b[22m// unknown commit, empty staging area, ...). Exits 1.\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22mrepo_\u001b[16Grr\u001b[19Gr(string me\u001b[31Gsage) MiniGitError `public\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +6 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m \u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(hash.pr)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[0.017, "o", "\u001b[?25l\u001b[H\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  4 \u001b[22mtype MiniGitError is error `public {\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;248;248;242m\u001b[2m  5 \u001b[22m    int status;\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22m}\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m  7 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  8 \u001b[22m// The command was used correctly but could not be carried out (missing file,\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;248;248;242m\u001b[2m  9 \u001b[22m// unknown commit, empty staging area, ...). Exits 1.\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22mrepo_error(string message) MiniGitError `public\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m… +6 lines \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(hash.pr)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m21\u001b[22m lines to \u001b[1mhash.pr\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m1\u001b[10G\u001b[22m// Content addressing: FNV-1a, 64-bit.\r\u001b[7C\u001b[1B\u001b[2m2\u001b[10G\u001b[22m//\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m3\u001b[10G\u001b[22m//\u001b[13GThe whole tool leans on this one property: the same bytes always produce the\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m// same id, in this run and i"]
[0.000, "o", "n every later one. FNV-1a is not a cryptographic\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m// hash — it is a deterministic, dependency-free one, which is exactly what a\r\u001b[7C\u001b[1B\u001b[2m6\u001b[13G\u001b[22mcontent-\u001b[22Gd\u001b[24Gres\u001b[28Ged store n\u001b[39Geds to be reproduci\u001b[59Gle.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m7\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 8\u001b[10G\u001b[22mfnv1a_64(u8[] data) u64 `public {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  9 \u001b[22m    u64 hash = 0xcbf29ce484222325u64;   // FNV offset basis\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m    for byte in data {\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m… +11 lines \u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
