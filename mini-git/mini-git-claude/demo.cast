[0.081, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(main.pr)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[5C\u001b[2B\u001b[38;2;248;248;242m\u001b[2m 21 \u001b[22m         int status = 1;\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;248;248;242m\u001b[2m 22 \u001b[22m         if failure is MiniGitError { status = failure.status; }\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 23 -\u001b[38;2;248;248;242m        stderr.write_line(\"minigit: {failure.message}\");                                               \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 23 +\u001b[38;2;248;248;242m        // If even the diagnostic cannot be written there is nothing left to                           \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 24 +\u001b[38;2;248;248;242m        // report it with — the exit status below still carries the failure.                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 25 +\u001b[38;2;248;248;242m        stderr.write_line(\"minigit: {failure.message}\") ? { };                       "]
