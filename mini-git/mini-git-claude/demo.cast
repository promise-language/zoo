[0.038, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(main.pr)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m 20 \u001b[22m     run(os.args) ? failure {\r\u001b[1B\u001b[39m     \u001b[38;2;248;248;242m\u001b[2m 21 \u001b[22m         int status = 1;\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m2\u001b[15G\u001b[22m    if failure\u001b[30Gis MiniGitError { status = failure.status; }\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 23 -\u001b[38;2;248;248;242m        stderr.write_line(\"minigit: {failure.message}\");                                               \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 23 +\u001b[38;2;248;248;242m        // If even the diagnostic cannot be written there is nothing left to                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 24 +\u001b[38;2;248;248;242m        // report it with — the exit status below still carries the failure.                           \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m5\u001b[19G\u001b[38;2;248;248;242mstderr.write_line(\"minigit: {failure.message}\") ?\u001b"]
