[0.000, "o", "9m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mprint_line(\"{answer()}\");\r\u001b[5C\u001b[1B}\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mEOF\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mpromis…\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(BUG-format-merges-comment-blocks.md)\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[0.018, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;153;153;153matchpad/repro; cd $S; cat > fmtblank.pr <<'EOF'\r\u001b[5C\u001b[1B// File header: what this file is about.\r\u001b[5C\u001b[1B// What this function does.\r\u001b[5C\u001b[1Banswer() int => 42;\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mmain() {\r\u001b[5C\u001b[1Bprint_line(\"{answer()}\");\r\u001b[5C\u001b[1B}\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mEOF\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153mpromis…\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(BUG-format-merges-comment-blocks.md)\r\u001b[4C\u001b[1B\u001b[38;2;153;153;153m \u001b[39mWrote \u001b[1m68\u001b[22m lines to \u001b[1mBUG-format-merges-comment-blocks.md\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  1 \u001b[22mPlease file this upstream at https://github.com/promise-language/promise/issues\r\u001b[5C\u001b[1B\u001b[2m  2 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  3 \u001b[22m# `promise format` deletes the blank line between two top-level comment blocks, merging a file header in\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22mto the next declaration's doc comment\r\u001b[5C\u001b[1B\u001b[2m  4 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  6 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;"]
[0.000, "o", "242m\u001b[2m  7 \u001b[22mCosmetic, but it hits every multi-file project: the file-level header comment and\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22mthe doc comment of the first declaration end up as one undifferentiated block.\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 10 \u001b[22m## Minimal repro\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m… +59 lines \u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[0.041, "o", "\u001b[?25l\u001b[H\r\u001b[24B\u001b[38;2;215;119;87m✳\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[0.131, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;248;248;242m\u001b[2m 4 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 5 \u001b[22m`promise version 2026.6 (channel stable)` · macOS 26.5.1 (arm64, Apple Silicon)\r\u001b[5C\u001b[1B\u001b[2m 6 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 7 \u001b[22m## Minimal repro\r\u001b[5C\u001b[1B\u001b[2m 8 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 9 \u001b[22mA two-file application project where both files import `io`:\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +85 lines \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
