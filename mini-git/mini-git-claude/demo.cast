[0.091, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +65 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(SUMMARY.md)\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote \u001b[1m195\u001b[22m lines\u001b[22Gto\u001b[25G\u001b[1mSUMMARY.md\r\u001b[1B\u001b[22m     \u001b[38;2;248;248;242m\u001b[2m  1 \u001b[22m# mini-git in Promise — summary\r\u001b[7C\u001b[1B\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m3\u001b[10G\u001b[22m## What I built\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m5\u001b[10G\u001b[22m`minigit`, a self-contained content-addressed version control tool: ~650 lines of\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22mProm\u001b[15Gse acros\u001b[24G seven files,\u001b[38Gscaffolde\u001b[48G with `promise init`, built into a\u001b[83Gs\u001b[86Ggle\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m7\u001b[10G\u001b[22mbinary with `promise\u001b[31Gbuild`, and driven entirely from the command\u001b[76Gline.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m8\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m9\u001b[10G\u001b[22m| file | what lives there |\r\u001b[6C\u001b[1B\u001b[2m"]
