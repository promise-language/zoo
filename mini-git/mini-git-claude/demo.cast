[0.052, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  4 \u001b[22m//     .minigit/\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  5 \u001b[22m//       objects/<blob hash>   the raw bytes of every added file\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  6 \u001b[22m//       commits/<commit id>   one serialized commit per file (see commit.pr)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  7 \u001b[22m//       index                 the staging area: \"<blob hash> <filename>\" lines\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  8 \u001b[22m//       HEAD                  the current commit id; empty before the first one\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 9\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m10\u001b[10G\u001b[22muse\u001b[14Gio;\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +140 lines \r\u001b[8C\u001b[2B\u001b[39mcommands.pr)\r\u001b[11C\u001b[1B\u001b[1m231\u001b[25Gcommands.pr\r\u001b[12C\u001b[1B\u001b[22m\u001b[38;2;248;248;242mOn\u001b[17Gfunct\u001b[23Gon per subcommand. Each one validates its argum\u001b[71Gnts, does the\r\u001b[12C\u001b[1Bsmallest amount \u001b[30Gf work, and prints only what it changed.\r\u001b[9C\u001b[1B\u001b[39m\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;248;248;242muse\u001b[1"]
