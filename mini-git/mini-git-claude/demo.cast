[0.042, "o", "\u001b[?25l\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;78;186;101m⏺\u001b[39m \u001b[1mUpdate\u001b[22m(main.pr)\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded \u001b[1m3\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m0\u001b[15G\u001b[22mrun(os.args) ?\u001b[30Gfailure {\r\u001b[7C\u001b[1B\u001b[2m1\u001b[20G\u001b[22mnt status\u001b[30G= 1;\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 22 \u001b[22m         if failure is MiniGitError { status = failure.status; }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 23 -\u001b[38;2;248;248;242m        stderr.write_line(\"minigit: {failure.message}\");                                               \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m3\u001b[22G\u001b[38;2;248;248;242mIf even \u001b[31Ghe diagnostic cannot be\u001b[55Gwritten there is nothing left to\r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m4\u001b[19G\u001b[38;2;248;248;242m// report it w\u001b[34Gth — the exit stat\u001b[53Gs below still\u001b[67Gcarries\u001b[75Gthe\u001b[79Gfailure.\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 25 +\u001b[38;2;248;248;242m        stderr.write_line(\"minigit: {failure.message}\") ? { };       "]
