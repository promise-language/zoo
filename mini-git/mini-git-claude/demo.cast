[0.000, "o", "d.                                                   \r\u001b[7C\u001b[1B\u001b[38;2;80;200;80m2\u001b[11G\u001b[38;2;248;248;242msplit_first!(string line, string separator) (string, string) `public {  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 13 +\u001b[38;2;248;248;242m    if at := line.index_of(separator) {                                                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 14 +\u001b[38;2;248;248;242m        return (line[0:at], line[at + separator.len:]);                                                \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m5\u001b[11G\u001b[22m  \u001b[14G }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 16 +\u001b[38;2;248;248;242m    raise repo_error(\"malformed line (expected '{separator}'): {line}\");                               \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m 17 \u001b[22m }\u001b[13G\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;248;248;242m\u001b[2m 18 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 19 \u001b[22m // Filenames in sorted order. Every listing minigit prints goes through here, so\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m⏺\u001b[3G\u001b[39mRunning \u001b[1m6\u001b[22m shell commands"]
