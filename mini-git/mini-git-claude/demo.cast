[0.000, "o", "                                                    \r\n  ───────────────┼─────────────────────────────────────────────────────────────────────────────────\r\n   \u001b[38;5;252m\u001b[38;5;203;48;5;236m main.pr \u001b[0m\u001b[0m     │ \u001b[38;5;252margv dispatch; maps failures onto exit codes (1 = operation failed, 2 =\u001b[0m\u001b[38;5;252m misuse)\u001b[0m \r\n   \u001b[38;5;252m\u001b[38;5;203;48;5;236m commands.pr \u001b[0m\u001b[0m │ \u001b[38;5;252mone function per subcommand, plus the argument\u001b[0m\u001b[38;5;252m checks\u001b[0m                           \r\n   \u001b[38;5;252m\u001b[38;5;203;48;5;236m store.pr \u001b[0m\u001b[0m    │ \u001b[38;5;252mthe \u001b[0m\u001b[38;5;252m\u001b[38;5;203;48;5;236m .minigit/ \u001b[0m\u001b[0m\u001b[38;5;252m directory: blobs, commits, index, HEAD, raw byte\u001b[0m\u001b[38;5;252m I/O\u001b[0m            \r\n   \u001b[38;5;252m\u001b[38;5;203;48;5;236m commit.pr \u001b[0m\u001b[0m   │ \u001b[38;5;252mthe \u001b[0m\u001b[38;5;252m\u001b[38;5;203;48;5"]
[0.000, "o", ";236"]
[0.000, "o", "m Commit \u001b[0m\u001b[0m\u001b[38;5;252m record and its canonical text\u001b[0m\u001b[38;5;252m format\u001b[0m                               \r\n   \u001b[38;5;252m\u001b[38;5;203;48;5;236m hash.pr \u001b[0m\u001b[0m     │ \u001b[38;5;252mFNV-1a (64-bit) content\u001b[0m\u001b[38;5;252m addressing\u001b[0m                                              \r\n   \u001b[38;5;252m\u001b[38;5;203;48;5;236m text.pr \u001b[0m\u001b[0m     │ \u001b[38;5;252mshared line-format helpers (split, sort,\u001b[0m\u001b[38;5;252m escape)\u001b[0m                                \r\n   \u001b[38;5;252m\u001b[38;5;203;48;5;236m errors.pr \u001b[0m\u001b[0m   │ \u001b[38;5;252m\u001b[38;5;203;48;5;236m MiniGitError is error \u001b[0m\u001b[0m\u001b[38;5;252m, carrying the exit\u001b[0m\u001b[38;5;252m status\u001b[0m                               \r\n  \r\n\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mState on disk is four things: \u001b[0m\u001b[38;5;203;48;5;236m objects/<hash> \u001b[0m\u001b[38;5;252m (raw bytes of every added\u001b[0m\u001b[38;5;252m file),\u001b[0m\r\n\u001b[0m\u001b[38;5;203;48;5;236m\u001b[0m\u001b[38;5;203;48;5;236m\u001b[0m  \u001b[38;5;203;48;5;236m commits/<id> \u001b[0m\u001b[38;5;252m (one commit per file), \u001b[0m\u001b[38;5;203;48;5;236m index \u001b[0m\u001b[38"]
[0.000, "o", ";5;25"]
[0.000, "o", "2m (the staging area) and \u001b[0m\u001b[38;5;203;48;5;236m HEAD \u001b[0m\u001b[38;5;252m.\u001b[0m\u001b[38;5;252m A\u001b[0m\r\n\u001b[0m\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mcommit's id is the FNV-1a hash of its own serialized text — I verified\u001b[0m\u001b[38;5;252m that\u001b[0m\r\n\u001b[0m\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mindependently by recomputing FNV-1a over \u001b[0m\u001b[38;5;203;48;5;236m .minigit/commits/<id> \u001b[0m\u001b[38;5;252m in Python\u001b[0m\u001b[38;5;252m and\u001b[0m\r\n\u001b[0m\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mgetting the id back. Output is deterministic: every filename listing goes\u001b[0m\u001b[38;5;252m through\u001b[0m\r\n\u001b[0m\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mone \u001b[0m\u001b[38;5;203;48;5;236m sorted_names \u001b[0m\u001b[38;5;252m helper, and the blob lines inside a commit are sorted too,\u001b[0m\u001b[38;5;252m so\u001b[0m\r\n\u001b[0m\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mthe id depends on the file \u001b[0m\u001b[38;5;252;3mset\u001b[0m\u001b[38;5;252m and not on staging\u001b[0m\u001b[38;5;252m order.\u001b[0m\r\n  \r\n\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mA commit records exactly what was staged (the task's wording"]
