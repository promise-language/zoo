[0.000, "o", "\r\n\u001b[38;5;228;48;5;63;1m\u001b[0m\u001b[38;5;228;48;5;63;1m\u001b[0m  \u001b[38;5;228;48;5;63;1m \u001b[0m\u001b[38;5;228;48;5;63;1mmini-git in Promise —\u001b[0m\u001b[38;5;228;48;5;63;1m summary\u001b[0m\u001b[38;5;228;48;5;63;1m \u001b[0m\u001b[38;5;252m\u001b[0m\r\n\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252m\u001b[0m\r\n\u001b[0m\u001b[38;5;39;1m\u001b[0m\u001b[38;5;39;1m\u001b[0m  \u001b[38;5;39;1m## \u001b[0m\u001b[38;5;39;1mWhat I\u001b[0m\u001b[38;5;39;1m built\u001b[0m\u001b[38;5;252m\u001b[0m\r\n\u001b[0m  \r\n\u001b[38;5;203;48;5;236m\u001b[0m\u001b[38;5;203;48;5;236m\u001b[0m  \u001b[38;5;203;48;5;236m minigit \u001b[0m\u001b[38;5;252m, a self-contained content-addressed version control tool: ~\u001b[0m\u001b[38;5;252m650 lines\u001b[0m\u001b[38;5;252m of\u001b[0m\r\n\u001b[0m\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mPromise across seven files, scaffolded with \u001b[0m\u001b[38;5;203;48;5;236m promise init \u001b[0m\u001b[38;5;252m, built into a\u001b[0m\u001b[38;5;252m single\u001b[0m\r\n\u001b[0m\u001b[38;5;252m\u001b[0m\u001b[38;5;252m\u001b[0m  \u001b[38;5;252mbinary with \u001b[0m\u001b[38;5;203;48;5;236m promise build \u001b[0m\u001b[38;5;252m, and driven entirely from the command\u001b[0m\u001b[38;5;252m line.\u001b[0m\r\n  \r\n   \u001b[38;5;252mfile\u001b[0m          │ \u001b[38;5;252mwhat lives\u001b[0m\u001b[38;5;252m there\u001b[0m    "]
