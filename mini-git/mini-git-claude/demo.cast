[0.000, "o", "     return\u001b[26G(line[0:\u001b[35Gt],\u001b[39Gline[at + separator.len:]); \u001b[68G         \u001b[78G           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 15 \u001b[22m     }\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m16\u001b[11G\u001b[38;2;248;248;242m  \u001b[14G raise repo_er\u001b[30Gr(\"malformed line (expected '{sep\u001b[64Grator}'): {line}\");      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 17 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 18 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m 19 \u001b[22m // Filenames in sorted order. Every listing minigit prints goes through here, so\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m⏺\u001b[3G\u001b[39mRunning \u001b[1m8\u001b[22m shell commands…\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  $ python3 - <<'PY'\r\u001b[5C\u001b[1Bimport pathlib\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m# Re-insert the blank line the formatter removes between a file-header comment\r\u001b[5C\u001b[1B# block and the first declaration / doc comment that follows it.\r\u001b[5C\u001b[1Banchors = {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m\"commands.pr\": \"// minigit init — lay out\",\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;153;153;153m\"commit.pr\": \"type Commit `publi"]
