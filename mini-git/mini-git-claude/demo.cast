[0.322, "o", "\u001b[?25l\u001b[H\r\u001b[1B     \u001b[38;2;248;248;242m\u001b[2m  5 \u001b[22m`minigit`, a self-contained content-addressed version control tool: ~650 lines of\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22mPromise across seven files, scaffolded with `promise init`, built into a single\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22mbinary with `promise build`, and driven entirely from the command line.\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m9\u001b[10G\u001b[22m| file | what lives there |\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22m|---|---|\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +185 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m2\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mDone. \u001b[38;2;177;185;249mminigit\u001b[39m is\u001b[20Gbuilt\u001b[26Gand\u001b[30Gworking.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat's here\u001b[15G\u001b[22m—\u001b[17G655\u001b[21Glines\u001b[27Gof\u001b[30GPromise\u001b[38Gin\u001b[41Gseven\u001b[47Gfiles,\u001b[54Gscaffolded\u001b[65Gwith\u001b[70G\u001b[38;2;177;185;249mpromise init\u001b[39m,\u001b[84Gbuilt\u001b[90Gwith\u001b[95G\u001b[38;2;177;185;249mpromise build\u001b[109G\u001b[39minto\u001b[114Ga\r\u001b[2C\u001b[1Bsingle \u001b[38;2;177;185;249mminigit\u001b[39m"]
