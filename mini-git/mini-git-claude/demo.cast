[0.000, "o", "[22muse path;\r\u001b[7C\u001b[1B\u001b[2m6\u001b[14G\u001b[22mtime;\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m8\u001b[10G\u001b[22m// minigit init — lay out .minigit/, or report that it is already there.\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22mcmd_init!(string[] args) {\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22m  \u001b[13G expec\u001b[20G_none(\"init\", args);\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +221 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m⏺\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(main.pr)\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
[0.024, "o", "\u001b[?25l\u001b[H\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 39 +\u001b[38;2;248;248;242m        \"checkout\" => cmd_checkout(rest),                                                              \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 40 +\u001b[38;2;248;248;242m        \"reset\" => cmd_reset(rest),                                                                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 41 +\u001b[38;2;248;248;242m        \"help\" => print_line(usage_text()),                                                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 42 +\u001b[38;2;248;248;242m        _ => { raise usage_error(\"unknown command '{command}'\\n{usage_text()}\"); },                    \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 43 +\u001b[38;2;248;248;242m    }                                                                                                  \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 44 +\u001b[38;2;248;248;242m}                                                                                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 45 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 19 -\u001b[38;2;"]
[0.000, "o", "248;248;242m    safe := io.Dir.list(\"/nonexistent\") ? { string[](); };                                             \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;220;90;90m\u001b[48;2;61;1;0m 20 -\u001b[38;2;248;248;242m    print_line(\"Safe: {safe.len} items\");                                                              \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 46 +\u001b[38;2;248;248;242musage_text() string `public {                                                                          \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 47 +\u001b[38;2;248;248;242m    return \"\"\"usage: minigit <command> [arguments]                                                     \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 48 +\u001b[38;2;248;248;242m                                                                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 49 +\u001b[38;2;248;248;242m  init                        create the .minigit repository here                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 50 +\u001b[38;2;248;248;242m  add <file>                  store a fil"]
[0.000, "o", "e as a blob and stage its name                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 51 +\u001b[38;2;248;248;242m  rm <file>                   unstage a filename                                                       \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 52 +\u001b[38;2;248;248;242m  status                      list the staged filenames                                                \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 53 +\u001b[38;2;248;248;242m  commit -m \"<message>\"       record the staged files as a commit                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 54 +\u001b[38;2;248;248;242m  log                         show the commit chain, newest first                                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 55 +\u001b[38;2;248;248;242m  show <commit>               show one commit and its files                                            \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 56 +\u001b[38;2;248;248;242m  diff <commit-a> <commit-b>  compare two commits' file sets                                           \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 57 +\u001b[38;2;248;24"]
[0.000, "o", "8;242m  checkout <commit>           restore a commit's files into the working directory                      \r\u001b[5C\u001b[1B\u001b[38;2;80;200;80m 58 +\u001b[38;2;248;248;242m  reset <commit>              move the current commit, keep the working files\"\"\";                      \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m 59 \u001b[22m }\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;220;129;97mBrewing…\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
